# Supabase — from your project's Settings → API.
# Supabase has two key-naming schemes; use whichever your dashboard shows.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key for the browser (read-only board + realtime).
#   Classic dashboards: the "anon" key  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Newer dashboards:    "publishable"   ->  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Set ONE of these:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET server-only key — every write goes through this. Never expose it.
#   Classic: the "service_role" key  ->  SUPABASE_SERVICE_ROLE_KEY
#   Newer:   the "secret" key        ->  SUPABASE_SECRET_KEY
# Set ONE of these:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# SUPABASE_SECRET_KEY=sb_secret_...

# Static leader code. Designated leaders (LEADER_NAMES in lib/board-data.ts, or
# anyone with players.is_leader = true) enter this once per device via the nav
# bar's UNLOCK LEADER button to activate their controls. Pick anything; share it
# only with the leaders.
LEADER_CODE=change-me
